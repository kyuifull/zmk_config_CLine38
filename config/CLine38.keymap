#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <behaviors/runtime_macro.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/* 大西配列。zmk-config-coron (coron_V2.keymap) をベースに CLine38 の 38 キーへ詰めたもの。
   coron の外側列 (Shift / Ctrl 等の修飾キー) は省略している。

   レイヤー:
     0 BASE    大西配列
     1 FUNC    数字・F キー           (td_1 ホールド)
     2 SYMBOL  記号・カーソル         (td_2 ホールド)
     3 TENKEY  テンキー               (Q ホールド。TENKEY 内の右端親指 tog 3 でトグル)
     4 SCROLL  トラックボールでスクロール (R ホールド。CLine38_R.overlay の scroller)
     5 SYSTEM  Bluetooth・ブートローダ (td_1 + td_2 同時ホールド)

   オートマウスレイヤーは使わない (小型でトラックボールに触れやすいため)。
   クリックは右上段のコンボで行う: W+R = 左, R+Y = 右, W+Y = 中央 */

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {
    combos {
        compatible = "zmk,combos";

        /* Positions follow &default_transform in CLine38.dtsi:
             row0 0..9   row1 10..19   row2 20..29   thumbs 30..37 */

        lang_e {                    /* A + O : 英数 */
            bindings = <&to_layer_0 LANGUAGE_2>;
            key-positions = <12 13>;
            layers = <0>;
        };

        lang_j {                    /* T + N : かな */
            bindings = <&to_layer_0 LANGUAGE_1>;
            key-positions = <16 17>;
            layers = <0>;
        };

        double_n {                  /* N + S : NN */
            bindings = <&double_n>;
            key-positions = <17 18>;
            layers = <0>;
        };

        mo_system {                 /* td_1 + td_2 held together */
            bindings = <&mo 5>;
            key-positions = <33 36>;
            layers = <0>;
        };

        /* マウスクリック。"ry" (りゃ/りゅ/りょ) などの打鍵中に誤爆しないよう、
           直前のキー入力から少し間が空いているときだけ成立させる。 */

        mouse_left {                /* W + R */
            bindings = <&mkp MB1>;
            key-positions = <6 7>;
            layers = <0>;
            timeout-ms = <40>;
            require-prior-idle-ms = <150>;
        };

        mouse_right {               /* R + Y */
            bindings = <&mkp MB2>;
            key-positions = <7 8>;
            layers = <0>;
            timeout-ms = <40>;
            require-prior-idle-ms = <150>;
        };

        mouse_middle {              /* W + Y */
            bindings = <&mkp MB3>;
            key-positions = <6 8>;
            layers = <0>;
            timeout-ms = <40>;
            require-prior-idle-ms = <150>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        double_n: double_N {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N &kp N>;
            label = "DOUBLE_N";
        };

        /* Arrow symbols via Windows Unicode hex input.
           Requires HKCU\Control Panel\Input Method\EnableHexNumpad = "1"
           (REG_SZ, then sign out/in) and NumLock on. */

        arrow_left: arrow_left {          /* ← : Alt + KP_PLUS + 2190 (Unicode hex input) */
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LEFT_ALT>
                , <&macro_tap &kp KP_PLUS &kp KP_N2 &kp KP_N1 &kp KP_N9 &kp KP_N0>
                , <&macro_release &kp LEFT_ALT>
                ;
            label = "ARROW_LEFT";
        };

        arrow_up: arrow_up {          /* ↑ : Alt + KP_PLUS + 2191 (Unicode hex input) */
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LEFT_ALT>
                , <&macro_tap &kp KP_PLUS &kp KP_N2 &kp KP_N1 &kp KP_N9 &kp KP_N1>
                , <&macro_release &kp LEFT_ALT>
                ;
            label = "ARROW_UP";
        };

        arrow_right: arrow_right {          /* → : Alt + KP_PLUS + 2192 (Unicode hex input) */
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LEFT_ALT>
                , <&macro_tap &kp KP_PLUS &kp KP_N2 &kp KP_N1 &kp KP_N9 &kp KP_N2>
                , <&macro_release &kp LEFT_ALT>
                ;
            label = "ARROW_RIGHT";
        };

        arrow_down: arrow_down {          /* ↓ : Alt + KP_PLUS + 2193 (Unicode hex input) */
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LEFT_ALT>
                , <&macro_tap &kp KP_PLUS &kp KP_N2 &kp KP_N1 &kp KP_N9 &kp KP_N3>
                , <&macro_release &kp LEFT_ALT>
                ;
            label = "ARROW_DOWN";
        };
    };

    behaviors {
        td_z: td_z {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_Z";
            #binding-cells = <0>;
            bindings = <&kp Z>, <&kp LC(Z)>, <&kp LC(LS(Z))>;
        };

        td_x: td_x {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_X";
            #binding-cells = <0>;
            bindings = <&kp X>, <&kp LC(X)>;
        };

        td_c: td_c {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_C";
            #binding-cells = <0>;
            bindings = <&kp C>, <&kp LC(C)>;
        };

        td_v: td_v {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_V";
            #binding-cells = <0>;
            bindings = <&kp V>, <&kp LC(V)>;
        };

        td_minus: td_minus {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_MINUS";
            #binding-cells = <0>;
            bindings = <&kp MINUS>, <&kp TILDE>;
        };

        td_question: td_question {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_QUESTION";
            #binding-cells = <0>;
            bindings = <&kp QUESTION>, <&kp EXCLAMATION>;
        };

        /* td_*: tap = key, hold = layer/modifier, tap then hold = key repeat
           (hold-tap with quick-tap-ms). Usage: &td_1 <layer> <key>, etc. */

        td_1: td_1 {
            compatible = "zmk,behavior-hold-tap";
            label = "TD_1";
            #binding-cells = <2>;
            bindings = <&mo>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <150>;
            quick-tap-ms = <150>;
        };

        td_2: td_2 {
            compatible = "zmk,behavior-hold-tap";
            label = "TD_2";
            #binding-cells = <2>;
            bindings = <&mo>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <150>;
            quick-tap-ms = <150>;
        };

        td_3: td_3 {
            compatible = "zmk,behavior-hold-tap";
            label = "TD_3";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <150>;
            quick-tap-ms = <150>;
        };

        td_space: td_space {
            compatible = "zmk,behavior-hold-tap";
            label = "TD_SPACE";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <150>;
            quick-tap-ms = <150>;
        };

        td_enter: td_enter {
            compatible = "zmk,behavior-hold-tap";
            label = "TD_ENTER";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <150>;
            quick-tap-ms = <150>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "BASE";
            bindings = <
&lt 3 Q              &td_z                 &kp U                &kp COMMA  &kp PERIOD                                     &kp F  &kp W  &lt 4 R             &kp Y                 &kp P
&mt LEFT_CONTROL E   &mt LEFT_SHIFT I      &mt LEFT_ALT A       &kp O      &td_minus                                      &kp K  &kp T  &mt LEFT_ALT N      &mt LEFT_SHIFT S      &mt LEFT_CONTROL H
&td_x                &td_c                 &td_v                &kp L      &kp SLASH                                      &kp G  &kp D  &kp M               &kp J                 &kp B
          &kp ESC   &td_question  &td_3 LEFT_ALT DELETE  &td_1 1 TAB  &td_space LEFT_CONTROL SPACE    &td_enter RIGHT_SHIFT ENTER  &td_2 2 BACKSPACE    &mt LEFT_GUI ENTER
            >;
        };

        func_layer {
            display-name = "FUNC";
            bindings = <
&kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5         &kp NUMBER_6  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0
&kp F1        &kp F2        &kp F3        &kp F4        &kp F5               &kp F6        &kp F7        &kp F8        &kp F9        &kp F10
&kp F11       &kp F12       &none         &none         &kp CAPSLOCK         &none         &none         &none         &none         &none
              &trans        &trans        &trans        &trans  &trans       &trans        &trans                                    &trans
            >;
        };

        symbol_layer {
            display-name = "SYMBOL";
            bindings = <
&kp HASH       &kp DOUBLE_QUOTES  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp AT_SIGN         &kp HOME     &kp RS(LEFT_ARROW)  &kp UP_ARROW    &kp RS(RIGHT_ARROW)  &kp PAGE_UP
&kp AMPERSAND  &kp SINGLE_QUOTE   &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp UNDERSCORE      &kp END      &kp LEFT_ARROW      &kp DOWN_ARROW  &kp RIGHT_ARROW      &kp PAGE_DOWN
&kp DOLLAR     &kp GRAVE          &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp TILDE           &trans       &arrow_left         &arrow_up       &arrow_right         &arrow_down
               &kp COLON          &kp SEMICOLON         &trans                 &trans  &trans      &trans       &trans                                                   &trans
            >;
        };

        tenkey_layer {
            display-name = "TENKEY";
            bindings = <
&none     &kp KP_NUMLOCK  &none    &none      &none              &kp ASTERISK     &kp PLUS         &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9
&kp TAB   &none      &kp PERCENT   &kp PIPE   &kp BACKSLASH      &kp SLASH        &kp MINUS        &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6
&none     &none      &none         &none      &none              &kp EQUAL        &kp KP_NUMBER_0  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3
          &trans     &trans        &trans        &trans &trans       &kp KP_ENTER  &kp KP_DOT                                         &tog 3
            >;
        };

        scroll_layer {
            display-name = "SCROLL";
            bindings = <
&trans  &trans  &trans  &trans  &trans                 &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                 &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                 &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans         &trans  &trans                  &trans
            >;
        };

        system_layer {
            display-name = "SYSTEM";
            bindings = <
&bt BT_SEL 4  &bt BT_SEL 3  &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0        &trans       &bt BT_NXT  &bt BT_PRV  &trans  &trans
&trans        &trans        &kp SPACE     &trans        &trans              &trans       &trans      &kp SPACE   &trans  &studio_unlock
&trans        &trans        &trans        &trans        &trans              &bootloader  &trans      &trans      &trans  &bt BT_CLR
        &trans  &trans        &trans        &trans  &trans      &trans        &trans                                    &bt BT_CLR_ALL
            >;
        };
    };
};
